# FLOW VL PAVA — exemple de variables d'environnement
# Copier ce fichier en .env.local pour le développement local.
# Ne jamais mettre de vraies clés dans Git.

# NextAuth (à renseigner quand l'authentification sera branchée)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Supabase (à renseigner plus tard, quand la base sera branchée)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
